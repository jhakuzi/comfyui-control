R","link":103},{"localized_name":"sigmas","name":"sigmas","type":"SIGMAS","link":104},{"localized_name":"latent_image","name":"latent_image","type":"LATENT","link":105}],"outputs":[{"localized_name":"output","name":"output","type":"LATENT","links":[106]},{"localized_name":"denoised_output","name":"denoised_output","type":"LATENT","links":[]}],"title":"Qwen edit sampling","properties":{"Node name for S&R":"SamplerCustomAdvanced"},"color":"#223","bgcolor":"#334"},{"id":96,"type":"VAEDecode","pos":[1228.9379443692164,338.9975081055496],"size":[300,70],"flags":{"pinned":true},"order":12,"mode":0,"inputs":[{"localized_name":"samples","name":"samples","type":"LATENT","link":106},{"localized_name":"vae","name":"vae","type":"VAE","link":107}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[108]}],"title":"Qwen 2.1 decode","properties":{"Node name for S&R":"VAEDecode"},"color":"#223","bgcolor":"#334"},{"id":97,"type":"SaveImage","pos":[1532.9356453146308,147.00057351166623],"size":[450,530],"flags":{"pinned":true},"order":13,"mode":0,"inputs":[{"localized_name":"images","name":"images","type":"IMAGE","link":108},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"3 - Qwen edited image - ACTIVE (edit-only preset)","properties":{"Node name for S&R":"SaveImage"},"widgets_values":["Edited/VeryComfy_Qwen21_Edit"],"widgets_values_named":{"filename_prefix":"Edited/VeryComfy_Qwen21_Edit"},"color":"#223","bgcolor":"#334"},{"id":98,"type":"Note","pos":[8.89437795597405,877.716005114379],"size":[831.329804720021,356.923769551124],"flags":{"pinned":true},"order":6,"mode":0,"inputs":[],"outputs":[],"title":"READ FIRST - branch selection and model requirements","properties":{"Node name for S&R":"Note"},"widgets_values":["QWEN IMAGE 2.1 TURBO EDIT\n\nKrea is preserved exactly in this file. Qwen SaveImage (97) starts MUTED.\nTo edit only: mute Krea SaveImage (9), unmute Qwen SaveImage (97), upload an image in LoadImage (88), enter an instruction (89), then Queue. Use Mute / Never (mode 2), not Bypass.\nThe companion EDIT_ONLY file already sets those two output modes.\n\nRequired files: qwen_image_2.1_turbo_int8_convrot.safetensors in models/diffusion_models; qwen3vl_8b_int8_convrot.safetensors in models/text_encoders; qwen_image_2.1_vae_bf16.safetensors in models/vae.\nAll added executable nodes are native ComfyUI nodes. Update ComfyUI if Qwen 2.1 or ManualSigmas is missing. Existing Krea custom nodes still need to be installed to load this combined graph.\n\nUse Euler, CFG 1 and the fixed ManualSigmas schedule (8 steps). No extra shift, Turbo LoRA or Krea model connection is needed. Negative text is unused at CFG 1.\nThe encode node supplies reference conditioning AND an empty output latent at the reference size. Do not replace it with a Krea latent or a VAEEncode img2img path. Resolution 1024 preserves aspect ratio at roughly 1 megapixel; 0 keeps source size rounded to 32 pixels.\n\nThis version assumes official safetensors Qwen weights, not the molbal GGUF. If using GGUF, replace ONLY Qwen UNETLoader with the compatible updated GGUF-Reboot loader and select a Qwen 2.1 Turbo GGUF; leave encoder, VAE and sampler as wired. Do not change the Krea loader.\n\nValidated structurally; local GPU execution/model availability has not been tested. An unchanged queued prompt may be cached and finish in 0.0s; change the edit prompt or seed to force a new edit. Ensure Qwen SaveImage is active."],"widgets_values_named":{"text":"QWEN IMAGE 2.1 TURBO EDIT\n\nKrea is preserved exactly in this file. Qwen SaveImage (97) starts MUTED.\nTo edit only: mute Krea SaveImage (9), unmute Qwen SaveImage (97), upload an image in LoadImage (88), enter an instruction (89), then Queue. Use Mute / Never (mode 2), not Bypass.\nThe companion EDIT_ONLY file already sets those two output modes.\n\nRequired files: qwen_image_2.1_turbo_int8_convrot.safetensors in models/diffusion_models; qwen3vl_8b_int8_convrot.safetensors in models/text_encoders; qwen_image_2.1_vae_bf16.safetensors in models/vae.\nAll added executable nodes are native ComfyUI nodes. Update ComfyUI if Qwen 2.1 or ManualSigmas is missing. Existing Krea custom nodes still need to be installed to load this combined graph.\n\nUse Euler, CFG 1 and the fixed ManualSigmas schedule (8 steps). No extra shift, Turbo LoRA or Krea model connection is needed. Negative text is unused at CFG 1.\nThe encode node supplies reference conditioning AND an empty output latent at the reference size. Do not replace it with a Krea latent or a VAEEncode img2img path. Resolution 1024 preserves aspect ratio at roughly 1 megapixel; 0 keeps source size rounded to 32 pixels.\n\nThis version assumes official safetensors Qwen weights, not the molbal GGUF. If using GGUF, replace ONLY Qwen UNETLoader with the compatible updated GGUF-Reboot loader and select a Qwen 2.1 Turbo GGUF; leave encoder, VAE and sampler as wired. Do not change the Krea loader.\n\nValidated structurally; local GPU execution/model availability has not been tested. An unchanged queued prompt may be cached and finish in 0.0s; change the edit prompt or seed to force a new edit. Ensure Qwen SaveImage is active."},"color":"#223","bgcolor":"#334"},{"id":99,"type":"LoaderGGUF","pos":[7.251580867694145,139.83693797993087],"size":[400.01660886165064,58],"flags":{"pinned":true},"order":7,"mode":0,"inputs":[{"localized_name":"gguf_name","name":"gguf_name","type":"COMBO","widget":{"name":"gguf_name"},"link":null}],"outputs":[{"localized_name":"MODEL","name":"MODEL","type":"MODEL","links":[114]}],"properties":{"Node name for S&R":"LoaderGGUF"},"widgets_values":["qwen_image_2.1_turbo_Q8_0.gguf"],"widgets_values_named":{"gguf_name":"qwen_image_2.1_turbo_Q8_0.gguf"}}],"links":[[98,90,0,92,0,"MODEL"],[99,89,0,92,1,"CONDITIONING"],[100,89,1,92,2,"CONDITIONING"],[101,91,0,95,0,"NOISE"],[102,92,0,95,1,"GUIDER"],[103,93,0,95,2,"SAMPLER"],[104,94,0,95,3,"SIGMAS"],[105,89,2,95,4,"LATENT"],[106,95,0,96,0,"LATENT"],[107,87,0,96,1,"VAE"],[108,96,0,97,0,"IMAGE"],[114,99,0,90,0,"MODEL"],[95,86,0,89,0,"CLIP"],[96,88,0,89,1,"IMAGE"],[97,87,0,89,4,"VAE"]],"groups":[{"id":6,"title":"QWEN IMAGE 2.1 TURBO EDIT - independent branch (read note below)","bounding":[1.5067420847700062,78.44097201446081,1990.7777312392077,1166.0346977063684],"color":"#6d609e","flags":{}}],"config":{},"extra":{"ds":{"scale":0.8537370799919426,"offset":[656.0788305939428,29.049767498685807]},"frontendVersion":"1.55.17","workflowRendererVersion":"LG","VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true},"extensions":{"seed_widgets":{"44":0}},"version":0.4}